# Copy to server/.env and fill in. Do not commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: a Twilio number in E.164 form, e.g. +15551234567
TWILIO_SMS_FROM=
# WhatsApp sender: Twilio sandbox is whatsapp:+14155238886; production needs your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=
PORT=5173
# Email via Resend (https://resend.com): API key and a verified sender, e.g. "Acme <hello@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=
# Public https URL of this server (needed to verify Twilio inbound webhooks), e.g. from a tunnel
PUBLIC_URL=
# Razorpay payment links (INR): key id and secret from the Razorpay dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Caller ID for voice calls (a Twilio voice-capable number); falls back to TWILIO_SMS_FROM
TWILIO_VOICE_FROM=
# Secret (16+ random characters) enabling POST /webhook/contact?key=... for Shopify/Pabbly/Zapier
INBOUND_KEY=
# AI chat agent (Anthropic API key from console.anthropic.com). Usage is billed by Anthropic.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
AGENT_MODEL=
# Or use Google Gemini instead (key from aistudio.google.com). Default model gemini-flash-latest.
GEMINI_API_KEY=
# Force a provider when both keys are set: anthropic or gemini
AGENT_PROVIDER=
