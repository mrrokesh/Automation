DATABASE_URL=postgresql://user:password@host:5432/dbname
# 32+ random characters. Generated for you by: npm run setup:env
PEPPER=
JWT_SECRET=
PORT=4000

# ---- Optional providers. Without them the workspace runs in simulated mode. ----
# Twilio (WhatsApp, SMS and voice calls). SMS sender is an E.164 number; the WhatsApp sandbox is whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Caller ID for voice calls (a voice-capable Twilio number); falls back to TWILIO_SMS_FROM
TWILIO_VOICE_FROM=
# Public https URL of this server. Needed to verify Twilio inbound webhooks, e.g. from a tunnel.
PUBLIC_URL=
# Email through Resend: API key and a verified sender, e.g. "Acme <hello@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=
# Razorpay payment links (INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret (16+ random characters) that enables POST /webhook/contact?key=... for Shopify, Zapier, Pabbly or Make
INBOUND_KEY=
# AI chat agent: Anthropic or Google Gemini. Usage is billed by the provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: force a provider (anthropic or gemini) and override the model
AGENT_PROVIDER=
AGENT_MODEL=
# Set to 1 when running behind a hosting platform's reverse proxy
TRUST_PROXY=
